# Backend
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Paste full service account JSON as a single-line string for Railway deployment:
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
METRICS_FILE=../../data/metrics/latest.json
CACHE_CLEAR_SECRET=change-me

# CORS (backend) — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
