# eBay API credentials
EBAY_APP_ID=your_ebay_app_id_here
EBAY_CERT_ID=your_ebay_cert_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# eBay Marketplace Account Deletion notifications (required to activate keyset)
# EBAY_VERIFICATION_TOKEN: copy from eBay Developer portal →
#   Hi [name] → Application Access Keys → [keyset] → Notifications → Verification Token
# EBAY_NOTIFICATION_ENDPOINT_URL: full public URL of the deletion endpoint,
#   e.g. https://your-app.railway.app/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=your_verification_token_here
EBAY_NOTIFICATION_ENDPOINT_URL=https://your-app.railway.app/ebay/account-deletion

# Scraper behaviour
REQUEST_DELAY_SECONDS=2.0
MAX_RETRIES=4
BACKOFF_MULTIPLIER=2.0
SELENIUM_HEADLESS=true

# Output
RAW_DATA_DIR=./data/raw

# Logging
LOG_LEVEL=INFO
